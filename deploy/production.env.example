# Plantilla docker --env-file: valores literales, sin export ni referencias Bash.
# Copiar y completar en /opt/athenet/competition.env de la EC2.
SERVER_PORT=8082
DB_URL=jdbc:postgresql://REEMPLAZAR_RDS_ENDPOINT:5432/competition_db
DB_USERNAME=competition_user
DB_PASSWORD=REEMPLAZAR_PASSWORD_COMPETITION
JWT_ISSUER_URI=https://login.microsoftonline.com/REEMPLAZAR_TENANT_ID/v2.0
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=REEMPLAZAR_API_CLIENT_ID,api://REEMPLAZAR_API_CLIENT_ID
INSTITUTION_API_URL=http://REEMPLAZAR_IP_PRIVADA_INSTITUCIONES:8080
CORS_ALLOWED_ORIGINS=https://REEMPLAZAR_FRONT_ORGANIZACION
RABBITMQ_HOST=172.31.47.209
RABBITMQ_PORT=5672
RABBITMQ_USER=athenet_admin
RABBITMQ_PASSWORD=REEMPLAZAR_PASSWORD_RABBITMQ
RABBITMQ_VHOST=/
RABBITMQ_SSL=false
